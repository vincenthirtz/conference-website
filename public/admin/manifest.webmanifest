{
  "name": "OW Women's Cup – Admin",
  "short_name": "OWWC Admin",
  "description": "Back-office staff OW Women's Cup : tournois, matches, équipes, support.",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "categories": ["sports", "productivity"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "background_color": "#0E0A1F",
  "theme_color": "#0E0A1F",
  "orientation": "portrait-primary",
  "lang": "fr",
  "icons": [
    {
      "src": "/img/logos/2026-logo.png",
      "sizes": "500x500",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.ico",
      "sizes": "16x16 32x32 48x48 64x64 128x128",
      "type": "image/x-icon"
    }
  ],
  "shortcuts": [
    {
      "name": "Notifications",
      "short_name": "Notifs",
      "description": "Préférences et statut Web Push",
      "url": "/admin/notifications"
    },
    {
      "name": "Tournois",
      "short_name": "Tournois",
      "description": "Tournois actifs et matchs",
      "url": "/admin/tournaments"
    },
    {
      "name": "Support",
      "short_name": "Support",
      "description": "Tickets ouverts",
      "url": "/admin/support"
    },
    {
      "name": "Cockpit cast",
      "short_name": "Cockpit",
      "description": "Cockpit caster",
      "url": "/caster/cockpit"
    }
  ]
}
