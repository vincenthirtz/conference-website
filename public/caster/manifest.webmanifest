{
  "name": "OW Women's Cup – Diffusion",
  "short_name": "OWWC Cast",
  "description": "Diffusion de l'OW Women's Cup : overlays, scènes et Twitch.",
  "start_url": "/admin/diffusion/overlays",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "categories": ["sports", "productivity"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "background_color": "#0E0A1F",
  "theme_color": "#0E0A1F",
  "orientation": "portrait-primary",
  "lang": "fr",
  "icons": [
    {
      "src": "/img/logos/2026-logo.png",
      "sizes": "500x500",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.ico",
      "sizes": "16x16 32x32 48x48 64x64 128x128",
      "type": "image/x-icon"
    }
  ]
}
