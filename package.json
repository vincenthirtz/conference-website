{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "tcg:audit": "node scripts/tcg-audit.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "admin:metrics": "node --import ./scripts/register-ts.mjs scripts/admin-metrics.ts",
    "player:metrics": "node --import ./scripts/register-ts.mjs scripts/player-metrics.ts",
    "start": "next start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "sync:api": "node scripts/sync-from-api.mjs",
    "sync:api:check": "node scripts/sync-from-api.mjs --check",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "maps:render": "node --import ./scripts/register-ts.mjs scripts/render-map-previews.ts",
    "maps:thumbs": "node scripts/render-map-thumbs.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "cookie": "^2.0.1",
    "hls.js": "^1.7.3",
    "next": "~16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "slugify": "^1.6.9",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.153.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
