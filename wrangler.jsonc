{
  // Worker « owwomenscup » : le site sur Cloudflare (OpenNext), déployé par
  // .github/workflows/cloudflare.yml à chaque mise à jour de `work`.
  // Doc : docs/CLOUDFLARE.md. Tant que le domaine pointe sur Netlify, il
  // n'est servi que sur https://owwomenscup.owwomenscup.workers.dev.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "owwomenscup",
  // Relais /api/*, tâches planifiées, noindex sur *.workers.dev, autour du
  // Worker OpenNext.
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Servi sur owwomenscup.fr (routes de la zone, docs/CLOUDFLARE.md) : plus
  // d'adresse technique *.workers.dev ni d'URL de prévisualisation.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "owwomenscup" },
    // Le Worker de l'API : il doit exister avant tout déploiement de celui-ci.
    { "binding": "API_WORKER", "service": "owwomenscup-api" }
  ],
  // Cache des pages (ISR) : bucket créé par la CI s'il manque.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "owwomenscup-opennext-cache"
    }
  ],
  // File de régénération ISR (Durable Object SQLite).
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "images": { "binding": "IMAGES" },
  // Un seul déclencheur ; les horaires des tâches sont dans cloudflare/crons.ts.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Relais vers https://api.owwomenscup.fr (API_PROXY_ORIGIN par défaut).
    "API_PROXY_PREFIXES": "/api/",
    // Lectures servies par le Worker de l'API, famille par famille, avec repli sur le
    // serveur (docs/API-WORKER.md). Vide = tout au serveur : le retour arrière.
    // Chemins exacts, `:id` = un UUID, `*` en dernier = tout ce qui suit. Avant d'ajouter
    // une route : vérifier que son GET n'écrit rien (sinon API_WORKER_UNREPLAYABLE_READS).
    // Pas tout /api/public/ (newsletter/confirm écrit) ni tout /api/teams/ (surtout des
    // routes privées) ni tout /api/admin/ (double authentification à prouver d'abord).
    "API_WORKER_ROUTES": "/api/health,/api/seasonal-logo,/api/leagues,/api/leagues/*,/api/public/tcg/live,/api/public/openapi,/api/public/v1/*,/api/news,/api/news/rss,/api/news/comments,/api/teams,/api/teams/:id,/api/team/:id/stats,/api/team/:id/maps,/api/tournaments,/api/tournaments/:id/prize-pool,/api/tournaments/:id/mvp-leaderboard,/api/tournament/:id/calendar.ics,/api/tournament/:id/qr,/api/players/leaderboard,/api/player/notifications,/api/player/dashboard,/api/player/progression,/api/player/team,/api/player/matches,/api/player/next-match,/api/admin/me,/api/admin/realtime/ticket,/api/admin/diffusion/overlay-presence,/api/bot/v1/*,/api/site-settings,/api/partners,/api/cast-members,/api/maps/stats,/api/games/*,/api/scrims,/api/scrims/ladder,/api/scrims/:id,/api/players/:id/profile,/api/public/free-players,/api/public/team-openings,/api/public/webhook-events,/api/docs,/api/tcg/*,/api/twitch-channels,/api/twitch/live,/api/blizzard-news,/api/blizzard-media,/api/patch-notes,/api/tournament/:id/maps,/api/tournament/:id/pool,/api/player/agenda.ics,/api/player/agenda,/api/player/agenda/subscription,/api/player/battlenet-status,/api/player/hero-preferences,/api/player/messages,/api/player/messages/:id,/api/player/my-teams,/api/player/network-status,/api/player/scouting,/api/player/team-health,/api/player/team-reviews,/api/player/team-rhythm,/api/player/teams-directory,/api/player/twitch-status,/api/player/update-profile,/api/player/discovery,/api/player/discovery/head-to-head,/api/player/discovery/profile,/api/player/discovery/search,/api/player/follows,/api/player/invitations,/api/player/matches/:id,/api/player/predictions,/api/player/predictions/leaderboard,/api/player/predictions/:id,/api/player/push/prefs,/api/player/realtime/ticket,/api/player/scrims,/api/player/tcg/collection,/api/player/tcg/cosmetics,/api/player/tcg/exclusion,/api/player/tcg/fanart,/api/player/tcg/packs,/api/player/tcg/photo,/api/player/tcg/sets,/api/player/tcg/showcase,/api/player/tcg/wallet,/api/player/tcg/welcome-gift,/api/player/tcg/trades,/api/player/tcg/trades/blocks,/api/player/tcg/trades/cards,/api/player/tcg/trades/partners,/api/player/tcg/trades/settings,/api/teams/join-requests,/api/teams/member-permissions,/api/teams/opening,/api/teams/scrim-requests,/api/teams/scrim-searches,/api/teams/search-players,/api/teams/transfer-requests,/api/teams/invitations,/api/teams/invite-links,/api/teams/matches/:id/lineup,/api/teams/scrim-plannings,/api/teams/scrim-plannings/:id,/api/teams/scrim-plannings/:id/suggest",
    // Écritures servies par le Worker de l'API, sans repli : une écriture ne se rejoue pas.
    // Le chemin du pont des signaux est reçu par le Worker lui-même, avec CRON_SECRET.
    "API_WORKER_WRITE_ROUTES": "/api/signals/notes,/api/bot/v1/*",
    // GET qui écrivent : au Worker, sans repli non plus (ce qu'ils consomment serait perdu).
    "API_WORKER_UNREPLAYABLE_READS": "/api/bot/v1/reminders",
    // « 1 » depuis la bascule (2026-10-28) : les tâches planifiées tournent
    // ici, plus chez Netlify. « 0 » coupe tout (retour arrière, docs/CLOUDFLARE.md).
    "CRONS_ENABLED": "1",
    // Double authentification du staff (utils/staffMfa.ts) : « true » = toute
    // page admin exige le second facteur. À poser EN MÊME TEMPS que la même
    // variable dans l'API (/etc/conference-api/api.env), qui protège les
    // routes sensibles. Procédure : docs/PLAN-espace-admin.md. Allumée le
    // 2026-10-29 (owner enrôlée) ; retour arrière : « false ».
    "STAFF_MFA_ENFORCED": "true"
  },
  // Pas de placement : les pages viennent du cache, le Worker tourne au plus
  // près de la visiteuse (mesure du 2026-10-27).
  "observability": { "enabled": true }
}
