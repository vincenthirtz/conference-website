# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # server only, never expose publicly
DISCORD_TEAM_SECRET="shared-secret-for-discord-bot"

# Contact form
NEXT_PUBLIC_FORMSPREE_ID="f/your-formspree-id"

# HelloAsso (dons / adhésions)
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=
# Secret partagé authentifiant le webhook HelloAsso. Configurer l'URL du
# webhook côté dashboard HelloAsso avec ?token=<cette valeur> (ou envoyer
# le header x-helloasso-signature). FAIL-CLOSED : sans cette variable, le
# endpoint /api/helloasso/webhook répond 503.
HELLOASSO_WEBHOOK_SECRET=

# Twitch live status / OAuth
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# URL de retour du flux CHAINE (connecter une chaine Twitch : predictions,
# EventSub websocket, actions de regie). Doit pointer sur
# /api/twitch/broadcaster-callback, le SEUL callback qui verifie le state signe
# par /api/admin/twitch/connect.
#
# ATTENTION : elle a longtemps porte /api/twitch/oauth-callback, qui est autre
# chose — l'echange de code de l'app caster Electron. L'erreur n'avait jamais
# fait surface parce qu'aucune chaine n'avait ete connectee ; elle aurait fait
# echouer la premiere tentative avec un state rejete et aucune explication.
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/broadcaster-callback

# URL de retour du flux OAuth JOUEUSE (rattacher son compte Twitch pour
# recevoir un drop TCG en direct). DISTINCTE de TWITCH_REDIRECT_URI, qui sert
# la connexion d'une CHAINE : Twitch accepte plusieurs URLs de retour par
# application, et les separer evite qu'un code destine a un flux atterrisse
# dans l'autre, ou son state signe le ferait echouer sans explication.
# Ce flux ne demande AUCUN scope : on veut savoir qui vient, pas agir en son
# nom. DORMANT tant que cette variable est vide : /api/auth/twitch/* repond
# alors 503 TWITCH_IDENTITY_NOT_CONFIGURED et l'ecran masque le bouton.
TWITCH_PLAYER_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# Signature des webhooks EventSub entrants (drop TCG en direct).
# Le recepteur est FAIL-CLOSED : sans ce secret il rend 503 et ne traite rien.
# Doit valoir exactement le secret fourni a Twitch a la souscription.
TWITCH_EVENTSUB_SECRET=

# Origine des URL de rappel EventSub (webhooks alertes, drop TCG, chat !mvp),
# p. ex. https://api.owwomenscup.fr — https strict, SANS barre finale. Absente
# (ou invalide) : l'origine du site, comme avant. Ne touche PAS aux liens
# d'e-mails/DM (SITE_URL). Même valeur sur le site et sur l'API. Les
# abonnements restés sur l'ancienne origine sont recréés au prochain
# « S'abonner » (Twitch ne modifie pas un callback).
EVENTSUB_CALLBACK_ORIGIN=

# Battle.net (Blizzard) OAuth — vérification d'identité BattleTag (anti-smurf)
# DORMANT tant que CLIENT_ID + CLIENT_SECRET ne sont pas renseignés : les
# endpoints /api/auth/battlenet/* répondent alors 503 BATTLENET_NOT_CONFIGURED.
# BLIZZARD_CLIENT_SECRET sert aussi de clé HMAC pour signer le state OAuth.
# BLIZZARD_OAUTH_BASE : EU/US/KR partagent oauth.battle.net (override pour tests).
# BLIZZARD_REDIRECT_URI doit correspondre à l'URI déclarée dans la console Blizzard.
# BLIZZARD_CLIENT_ID=
# BLIZZARD_CLIENT_SECRET=
# BLIZZARD_REGION=eu
# BLIZZARD_REDIRECT_URI=http://localhost:3000/api/auth/battlenet/callback
# BLIZZARD_OAUTH_BASE=https://oauth.battle.net

# Netlify API (pour la page publique des builds)
NETLIFY_SITE_ID=
NETLIFY_API_TOKEN=

# PWA /admin + Web Push notifications
# Generate the VAPID keypair once with: npx web-push generate-vapid-keys
# - NEXT_PUBLIC_VAPID_PUBLIC_KEY: exposed to client, used by PushManager.subscribe()
# - VAPID_PRIVATE_KEY: server-only secret, used by web-push to sign push payloads
# - NEXT_PUBLIC_ENABLE_PWA: set to "1" ONLY on master/prod (gates SW registration).
#   Leaving it unset on dev / deploy previews prevents SW cache pollution.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_ENABLE_PWA=

# Cron / scheduled functions (Netlify)
# Shared secret between Netlify scheduled functions and the /api/cron/* routes.
# Sent as `Authorization: Bearer <CRON_SECRET>` (or `?secret=`). Without it the
# cron routes refuse every request (fail-closed). Also used as the default HMAC
# key for the email unsubscribe token when UNSUBSCRIBE_SECRET is unset.
CRON_SECRET=
# Optional: origin targeted by the Netlify scheduled functions
# (`${CRON_API_BASE_URL}/api/cron/<x>`), e.g. https://api.owwomenscup.fr once
# the API runs as a separate service. Netlify reserves `URL` (not overridable),
# hence this dedicated variable. Must be https (no credentials/query/fragment);
# trailing slash is stripped. Invalid value = ignored + error log. Unset = the
# historical chain URL || SITE_URL || https://owwomenscup.fr
# (netlify/functions/_lib/cronBaseUrl.ts). Set it in the Netlify dashboard.
CRON_API_BASE_URL=

# Email notifications (Brevo) — digest cron + transactional + unsubscribe
# - BREVO_API_KEY: server-only API key (Brevo > SMTP & API > API Keys). Free
#   tier = 300 emails/day; the digest cron runs twice daily to stay under it.
# - EMAIL_FROM: verified sender address (must be a validated Brevo sender).
# - EMAIL_FROM_NAME: display name shown in the recipient's inbox.
BREVO_API_KEY=
EMAIL_FROM=noreply@owwomenscup.fr
EMAIL_FROM_NAME=OW Women's Cup
# Optional: dedicated HMAC key for the one-click email unsubscribe token
# (GET /api/email/unsubscribe?token=...). Falls back to CRON_SECRET if unset.
# Rotating it invalidates previously issued unsubscribe links.
UNSUBSCRIBE_SECRET=

# Mesure d'audience (lot 0 — docs/BACKLOG-acquisition-joueuses.md)
# Fournisseur agnostique : "plausible" ou "umami". Les TROIS variables doivent
# être posées, sinon l'analytics est un no-op complet (aucun script chargé,
# aucun événement envoyé) et la CSP reste inchangée.
# - NEXT_PUBLIC_ANALYTICS_PROVIDER: plausible | umami
# - NEXT_PUBLIC_ANALYTICS_HOST: origine https du collecteur, SANS slash final
#   (ex. https://plausible.io, ou https://stats.owwomenscup.fr en auto-hébergé).
#   Cette valeur est ajoutée à script-src/connect-src dans la CSP (proxy.ts) —
#   elle doit donc être une origine https simple, sans chemin.
# - NEXT_PUBLIC_ANALYTICS_SITE_ID: `data-domain` pour Plausible (le domaine
#   déclaré dans le dashboard), `data-website-id` (UUID) pour Umami.
# Rien n'est collecté sans consentement explicite sur la catégorie `analytics`
# du bandeau cookies (lib/analytics/consent.ts).
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_HOST=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# Double authentification (TOTP) du staff — docs/PLAN-espace-admin.md
# (« Sécurité des comptes staff »). COUPÉE par défaut : seules true / 1 / on
# l'activent. Active, toute page admin exige une session aal2 et les routes
# sensibles (owner, manage_tenant, manage_billing, manage_staff, clés d'API)
# refusent une session aal1. N'activer qu'après enrôlement de tout le staff.
STAFF_MFA_ENFORCED=

# Bot Discord (dépôt owwc-discord-bot, hébergé sur un VPS dédié)
# URL du webhook du bot pour les événements poussés par le site
# (prod : https://bot.owwomenscup.fr/bot/site-events). L'inventaire de guild
# est résolu à côté (…/bot/guild-inventory). VIDE = aucun push HTTP : les
# événements restent dans l'outbox, que le bot relève par son poller.
BOT_WEBHOOK_URL=

# API distante (dépôt conference-api, https://api.owwomenscup.fr)
# Bascule progressive des appels navigateur, famille par famille
# (utils/remoteApi.ts) : NEXT_PUBLIC_API_REMOTE_PREFIXES liste les préfixes
# réécrits vers NEXT_PUBLIC_API_BASE_URL, séparés par des virgules
# (ex. /api/public/). VIDES = aucune réécriture, tout reste servi par le site.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_REMOTE_PREFIXES=

# Relais même-origine /api/* → conference-api (Edge Function Netlify
# netlify/edge-functions/api-proxy.ts, doc docs/EDGE-API-PROXY.md) pour les
# familles liées aux cookies du site. À poser dans Netlify (portée Functions),
# inutile en local. API_PROXY_PREFIXES : préfixes relayés séparés par des
# virgules (ordre conseillé : /api/onboard/, /api/twitch/, /api/auth/,
# /api/helloasso/, /api/admin/). API_PROXY_ORIGIN : vide = https://api.owwomenscup.fr.
# EDGE_PROXY_SECRET : `openssl rand -hex 32`, même valeur côté conference-api.
# Préfixes ou secret VIDES = relais inactif. Retour arrière : vider
# API_PROXY_PREFIXES puis redéployer.
API_PROXY_PREFIXES=
API_PROXY_ORIGIN=
EDGE_PROXY_SECRET=

# Régénération ISR à distance (utils/revalidate.ts, docs/EDGE-API-PROXY.md).
# REVALIDATE_REMOTE_URL : à poser UNIQUEMENT côté conference-api, valeur
# https://owwomenscup.fr/api/internal/revalidate — les handlers y POSTent les
# chemins à régénérer au lieu d'appeler res.revalidate (inutile hors Netlify).
# JAMAIS côté Netlify ni en local. REVALIDATE_SECRET : les DEUX côtés, même
# valeur (`openssl rand -hex 32`) ; absent côté site = route
# /api/internal/revalidate en 404. Vides = res.revalidate local, comme avant.
REVALIDATE_REMOTE_URL=
REVALIDATE_SECRET=
