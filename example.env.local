# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # server only, never expose publicly
DISCORD_TEAM_SECRET="shared-secret-for-discord-bot"

# Contact form
NEXT_PUBLIC_FORMSPREE_ID="f/your-formspree-id"

# HelloAsso (dons / adhésions)
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=
# Secret partagé authentifiant le webhook HelloAsso. Configurer l'URL du
# webhook côté dashboard HelloAsso avec ?token=<cette valeur> (ou envoyer
# le header x-helloasso-signature). FAIL-CLOSED : sans cette variable, le
# endpoint /api/helloasso/webhook répond 503.
HELLOASSO_WEBHOOK_SECRET=

# Twitch live status / OAuth
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Redirect URI to declare in Twitch developer console
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/oauth-callback

# Battle.net (Blizzard) OAuth — vérification d'identité BattleTag (anti-smurf)
# DORMANT tant que CLIENT_ID + CLIENT_SECRET ne sont pas renseignés : les
# endpoints /api/auth/battlenet/* répondent alors 503 BATTLENET_NOT_CONFIGURED.
# BLIZZARD_CLIENT_SECRET sert aussi de clé HMAC pour signer le state OAuth.
# BLIZZARD_OAUTH_BASE : EU/US/KR partagent oauth.battle.net (override pour tests).
# BLIZZARD_REDIRECT_URI doit correspondre à l'URI déclarée dans la console Blizzard.
# BLIZZARD_CLIENT_ID=
# BLIZZARD_CLIENT_SECRET=
# BLIZZARD_REGION=eu
# BLIZZARD_REDIRECT_URI=http://localhost:3000/api/auth/battlenet/callback
# BLIZZARD_OAUTH_BASE=https://oauth.battle.net

# Netlify API (pour la page publique des builds)
NETLIFY_SITE_ID=
NETLIFY_API_TOKEN=

# PWA /admin + Web Push notifications
# Generate the VAPID keypair once with: npx web-push generate-vapid-keys
# - NEXT_PUBLIC_VAPID_PUBLIC_KEY: exposed to client, used by PushManager.subscribe()
# - VAPID_PRIVATE_KEY: server-only secret, used by web-push to sign push payloads
# - NEXT_PUBLIC_ENABLE_PWA: set to "1" ONLY on master/prod (gates SW registration).
#   Leaving it unset on dev / deploy previews prevents SW cache pollution.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_ENABLE_PWA=

# Cron / scheduled functions (Netlify)
# Shared secret between Netlify scheduled functions and the /api/cron/* routes.
# Sent as `Authorization: Bearer <CRON_SECRET>` (or `?secret=`). Without it the
# cron routes refuse every request (fail-closed). Also used as the default HMAC
# key for the email unsubscribe token when UNSUBSCRIBE_SECRET is unset.
CRON_SECRET=

# Email notifications (Brevo) — digest cron + transactional + unsubscribe
# - BREVO_API_KEY: server-only API key (Brevo > SMTP & API > API Keys). Free
#   tier = 300 emails/day; the digest cron runs twice daily to stay under it.
# - EMAIL_FROM: verified sender address (must be a validated Brevo sender).
# - EMAIL_FROM_NAME: display name shown in the recipient's inbox.
BREVO_API_KEY=
EMAIL_FROM=noreply@owwomenscup.fr
EMAIL_FROM_NAME=OW Women's Cup
# Optional: dedicated HMAC key for the one-click email unsubscribe token
# (GET /api/email/unsubscribe?token=...). Falls back to CRON_SECRET if unset.
# Rotating it invalidates previously issued unsubscribe links.
UNSUBSCRIBE_SECRET=
