{
  "rules": [
    {
      "id": "quotidien-35-jours",
      "enabled": true,
      "conditions": { "prefix": "quotidien/" },
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 3024000 }
      }
    },
    {
      "id": "mensuel-400-jours",
      "enabled": true,
      "conditions": { "prefix": "mensuel/" },
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 34560000 }
      }
    },
    {
      "id": "envois-interrompus",
      "enabled": true,
      "conditions": { "prefix": "" },
      "abortMultipartUploadsTransition": {
        "condition": { "type": "Age", "maxAge": 86400 }
      }
    }
  ]
}
