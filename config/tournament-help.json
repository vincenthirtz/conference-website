          "role": "captain",
          "phase": "casts",
          "prereqs": ["Cast assigné non-acknowledgé", "Match dans [now, now+30 min]"],
          "endpoint": "GET /api/bot/v1/cast/upcoming?withinMinutes=30 (lecture cron) + POST /api/bot/v1/cast/:assignmentId/ack (clic bouton)",
          "impact": {
            "db": ["cast_assignments (update acked_at)"],
            "ui": ["DM Discord caster"]
          },
          "examples": [
            {
              "label": "Caster confirme sa présence",
              "payload": { "actorDiscordUserId": "<caster discord id>" },
              "expected": "Le bouton DM se grise et affiche « Confirmé à HH:MM ». Idempotent : 2e clic = 200 sans changer acked_at."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#cast-ack-dm"
        }
      ]
    },
    {
      "id": "matchs",
      "title": "4. Matchs : check-in, score, métadonnées",
