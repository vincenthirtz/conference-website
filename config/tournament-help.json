{
  "version": "2026-05-20.2",
  "sections": [
    {
      "id": "setup",
      "title": "1. Création & configuration d'un tournoi",
      "description": "Créer le tournoi côté site, ajouter une ou plusieurs phases (Swiss, élim, RR…), et générer un bracket vide pour pouvoir y inscrire des équipes.",
      "commands": [
        {
          "name": "creer-tournoi",
          "signature": "/creer-tournoi nom:<str> [statut] [debut] [fin] [equipes-max] [jeu]",
          "role": "admin",
          "phase": "setup",
          "prereqs": ["Rôle staff Discord (admin ou manager)"],
          "endpoint": "POST /api/bot/v1/tournaments",
          "impact": {
            "db": ["tournaments (insert)"],
            "ui": ["/admin/tournois", "/tournois"]
          },
          "examples": [
            {
              "label": "Brouillon Overwatch 8 équipes",
              "payload": {
                "actorDiscordUserId": "<staff discord id>",
                "name": "OW Women's Cup S2",
                "status": "draft",
                "maxTeams": 8,
                "game": "overwatch"
              },
              "expected": "Tournoi créé en brouillon, visible dans /admin/tournois."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#creer-tournoi"
        },
        {
          "name": "publier-tournoi",
          "signature": "/publier-tournoi tournoi-id:<uuid> [status:published|registration_open|in_progress|completed|cancelled|draft]",
          "role": "admin",
          "phase": "setup",
          "prereqs": ["Tournoi existant", "Rôle staff"],
          "endpoint": "POST /api/bot/v1/tournaments/:tournamentId/status",
          "impact": {
            "db": ["tournaments (update status)"],
            "ui": ["/tournois", "/admin/tournois"]
          },
          "examples": [
            {
              "label": "Passer en inscriptions ouvertes",
              "payload": {
                "actorDiscordUserId": "<staff discord id>",
                "status": "registration_open"
              },
              "expected": "Le tournoi devient visible publiquement, inscriptions activées."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#publier-tournoi"
        },
        {
          "name": "cloner-tournoi",
          "signature": "/cloner-tournoi tournoi-id:<uuid> [nom] [slug]",
          "role": "admin",
          "phase": "setup",
          "prereqs": ["Tournoi source existant", "Rôle staff"],
          "endpoint": "POST /api/bot/v1/tournaments/:tournamentId/clone",
          "impact": {
            "db": [
              "tournaments (insert)",
              "stages (insert)",
              "tournament_maps (insert)"
            ],
            "ui": ["/admin/tournois"]
          },
          "examples": [
            {
              "label": "Cloner un tournoi terminé pour la saison suivante",
              "payload": {
                "actorDiscordUserId": "<staff discord id>",
                "name": "OW Women's Cup S3",
                "slug": "owwc-s3"
              },
              "expected": "Nouveau tournoi en brouillon avec stages + map pool copiés depuis la source."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#cloner-tournoi"
        },
        {
          "name": "creer-phase",
          "signature": "/creer-phase tournoi:<autocomplete> nom:<str> [type:swiss|single-elim|double-elim|round-robin|other]",
          "role": "admin",
          "phase": "setup",
          "prereqs": ["Tournoi existant", "Rôle staff"],
          "endpoint": "POST /api/bot/v1/tournaments/:tournamentId/stages",
          "impact": {
            "db": ["stages (insert)"],
            "ui": ["/tournoi/<slug>", "/admin/tournois"]
          },
          "examples": [
            {
              "label": "Quart de finale single-elim",
              "payload": {
                "actorDiscordUserId": "<staff discord id>",
                "name": "Quart de finale",
                "type": "single-elim"
              },
              "expected": "Phase créée, son ID est retourné pour les commandes suivantes."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#creer-phase"
        },
        {
          "name": "generer-bracket-vide",
          "signature": "/generer-bracket-vide tournoi:<autocomplete> phase:<uuid> nombre:<int>",
          "role": "admin",
          "phase": "setup",
          "prereqs": ["Phase existante", "Rôle staff"],
          "endpoint": "POST /api/bot/v1/tournaments/:tournamentId/matches",
          "impact": {
            "db": ["matches (insert)"],
            "ui": ["/tournoi/<slug>", "/admin/tournois"]
          },
          "examples": [
            {
              "label": "8 matchs placeholder pour quart de finale",
              "payload": {
                "actorDiscordUserId": "<staff discord id>",
                "stageId": "<phase uuid>",
                "count": 8
              },
              "expected": "8 matchs placeholder créés dans la phase, prêts à recevoir des équipes."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#generer-bracket-vide"
        }
      ]
    },
    {
      "id": "equipes",
      "title": "2. Équipes & inscriptions",
      "description": "Créer une équipe, la rattacher à un tournoi, gérer roster, invitations, et changements de capitaine.",
      "commands": [
        {
          "name": "creer-mon-equipe",
          "signature": "/creer-mon-equipe (modal: nom, short_name, description)",
          "role": "captain",
          "phase": "equipes",
          "prereqs": ["Compte site lié (cf. /inscription)"],
          "endpoint": "POST /api/bot/v1/teams",
          "impact": {
            "db": ["teams (insert)", "team_members (insert capitaine)"],
            "ui": ["/equipes", "/equipe/<slug>"]
          },
          "examples": [
            {
              "label": "Création d'une équipe par sa future capitaine",
              "payload": {
                "actorDiscordUserId": "<captain discord id>",
                "name": "Les Phoenix",
                "shortName": "PHX",
                "description": "Équipe pour OWWC S2"
              },
              "expected": "Équipe créée, l'acteur en devient capitaine."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#creer-mon-equipe"
        },
        {
          "name": "modifier-equipe",
          "signature": "/modifier-equipe (modal éditable : nom, short_name, description, country, logo_url)",
          "role": "captain",
          "phase": "equipes",
          "prereqs": ["Être capitaine de l'équipe"],
          "endpoint": "PATCH /api/bot/v1/teams/:teamId",
          "impact": {
            "db": ["teams (update)"],
            "ui": ["/equipe/<slug>"]
          },
          "examples": [
            {
              "label": "Mise à jour du logo et du pays",
              "payload": {
                "actorDiscordUserId": "<captain discord id>",
                "logo_url": "https://...",
                "country": "FR"
              },
              "expected": "Champs mis à jour côté site, audit-log staff inscrit."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#modifier-equipe"
        },
        {
          "name": "inscrire-equipe",
          "signature": "/inscrire-equipe tournoi:<autocomplete> equipe:<autocomplete> [phase]",
          "role": "admin",
          "phase": "equipes",
          "prereqs": ["Tournoi + équipe existants", "Rôle staff"],
          "endpoint": "POST /api/bot/v1/tournaments/:tournamentId/teams",
          "impact": {
            "db": ["tournament_teams (insert)", "matches (update si phase précisée)"],
            "ui": ["/tournoi/<slug>", "/admin/tournois"]
          },
          "examples": [
            {
              "label": "Inscription d'une équipe en phase Swiss",
              "payload": {
                "actorDiscordUserId": "<staff discord id>",
                "teamId": "<team uuid>",
                "stageId": "<phase uuid>"
              },
              "expected": "L'équipe est rattachée au tournoi (et à la phase si fournie)."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#inscrire-equipe"
        },
        {
          "name": "inscrire-membre",
          "signature": "/inscrire-membre membre:<discord user> [role:player|substitute|coach|staff]",
          "role": "admin",
          "phase": "equipes",
          "prereqs": ["Rôle staff"],
          "endpoint": "POST /api/bot/v1/register-user",
          "impact": {
            "db": ["profiles (insert/update)", "discord_links (insert)"],
            "ui": ["/profil/<slug>"]
          },
          "examples": [
            {
              "label": "Pré-inscription d'une joueuse par le staff",
              "payload": {
                "actorDiscordUserId": "<staff discord id>",
                "discordUserId": "<member discord id>",
                "email": "joueuse@example.com",
                "role": "player"
              },
              "expected": "Compte site créé/lié, lien Discord ↔ profil enregistré."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#inscrire-membre"
        },
        {
          "name": "inscription",
          "signature": "/inscription (modal: email) [role]",
          "role": "player",
          "phase": "equipes",
          "prereqs": ["Aucun"],
          "endpoint": "POST /api/bot/v1/register-user",
          "impact": {
            "db": ["profiles (insert/update)", "discord_links (insert)"],
            "ui": ["/profil/<slug>"]
          },
          "examples": [
            {
              "label": "Une joueuse se crée un compte depuis Discord",
              "payload": {
                "actorDiscordUserId": "<self discord id>",
                "discordUserId": "<self discord id>",
                "email": "moi@example.com",
                "role": "player"
              },
              "expected": "Compte site créé, lien Discord ↔ profil enregistré."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#inscription"
        },
        {
          "name": "inviter send",
          "signature": "/inviter send membre:<user> [role:player|substitute|coach] [battletag] [message]",
          "role": "captain",
          "phase": "equipes",
          "prereqs": ["Être capitaine d'une équipe"],
          "endpoint": "POST /api/bot/v1/teams/:teamId/invitations",
          "impact": {
            "db": ["team_invitations (insert)", "demandes (insert)"],
            "ui": ["/equipe/<slug>", "/profil/<slug>"]
          },
          "examples": [
            {
              "label": "Inviter une joueuse en tant que titulaire",
              "payload": {
                "actorDiscordUserId": "<captain discord id>",
                "discordUserId": "<invited member discord id>",
                "role": "player",
                "battletag": "Player#1234",
                "message": "On t'attend !"
              },
              "expected": "Invitation envoyée, DM à la joueuse avec boutons Accepter/Refuser."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#inviter-send"
        },
        {
          "name": "inviter cancel",
          "signature": "/inviter cancel invitation-id:<uuid>",
          "role": "captain",
          "phase": "equipes",
          "prereqs": ["Avoir envoyé l'invitation OU être staff"],
          "endpoint": "POST /api/bot/v1/invitations/:demandeId",
          "impact": {
            "db": ["team_invitations (update status='cancelled')", "demandes (update)"],
            "ui": ["/equipe/<slug>"]
          },
          "examples": [
            {
              "label": "Annuler une invitation en attente",
              "payload": {
                "actorDiscordUserId": "<captain discord id>",
                "action": "cancel"
              },
              "expected": "L'invitation est marquée annulée."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#inviter-cancel"
        },
        {
          "name": "invite:accept | invite:reject (boutons DM)",
          "signature": "Boutons sur DM d'invitation (customId `invite:accept:<demandeId>` / `invite:reject:<demandeId>`)",
          "role": "player",
          "phase": "equipes",
          "prereqs": ["Avoir reçu l'invitation en DM"],
          "endpoint": "POST /api/bot/v1/invitations/:demandeId",
          "impact": {
            "db": ["team_invitations (update status)", "team_members (insert si accept)"],
            "ui": ["/equipe/<slug>"]
          },
          "examples": [
            {
              "label": "Accepter l'invitation",
              "payload": {
                "actorDiscordUserId": "<invited discord id>",
                "action": "accept"
              },
              "expected": "La joueuse rejoint l'équipe, audit-log inscrit."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#invite-buttons"
        },
        {
          "name": "quitter-equipe",
          "signature": "/quitter-equipe",
          "role": "player",
          "phase": "equipes",
          "prereqs": ["Faire partie d'une équipe et ne pas en être la capitaine"],
          "endpoint": "POST /api/bot/v1/teams/leave",
          "impact": {
            "db": ["team_members (delete)"],
            "ui": ["/equipe/<slug>"]
          },
          "examples": [
            {
              "label": "Une joueuse quitte son équipe",
              "payload": { "actorDiscordUserId": "<player discord id>" },
              "expected": "Joueuse retirée du roster, audit-log inscrit."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#quitter-equipe"
        },
        {
          "name": "team show / member / roster",
          "signature": "/team show id_ou_slug:<str> [roster:bool]  •  /team member membre:<user>  •  /roster equipe:<autocomplete>",
          "role": "public",
          "phase": "equipes",
          "prereqs": ["Aucun (lecture)"],
          "endpoint": "GET /api/bot/v1/teams/:teamId",
          "impact": {
            "db": [],
            "ui": ["/equipe/<slug>"]
          },
          "examples": [
            {
              "label": "Lecture du roster d'une équipe",
              "payload": null,
              "expected": "Embed Discord listant capitaine + roster + slug + logo."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#team-show"
        },
        {
          "name": "tournois",
          "signature": "/tournois [statut]",
          "role": "public",
          "phase": "equipes",
          "prereqs": ["Aucun"],
          "endpoint": "GET /api/bot/v1/tournaments",
          "impact": {
            "db": [],
            "ui": ["/tournois"]
          },
          "examples": [
            {
              "label": "Lister tous les tournois non-brouillons",
              "payload": null,
              "expected": "Liste paginée des tournois publiés / en cours / terminés."
            }
          ],
          "deeplink_admin": "/admin/aide-tournoi#tournois"
        }
      ]
    },
    {
      "id": "casts",
      "title": "3. Casts & assignations",
      "description": "Assigner des casteurs à des matchs, lister les casts à venir, retirer un cast.",
      "commands": [
