// Worker « owwomenscup-realtime » : salons temps réel (Durable Objects).
// Plan : docs/REALTIME-DO.md. Déployé par .github/workflows/realtime.yml.
// Les chemins sont relatifs à ce fichier.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "owwomenscup-realtime",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  // Adresse publique : realtime.owwomenscup.fr (domaine personnalisé ajouté
  // dans le tableau de bord, étape 2). L'adresse technique workers.dev reste
  // ouverte jusqu'à la bascule des écrans (étape 3).
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Pas de journal par requête : il garderait l'adresse de connexion, et la
  // Grande salle de lecture ne laisse aucune trace (realtime/protocol.ts). Les
  // lignes `[notify]`, `[publish]` et `[join]` restent.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
