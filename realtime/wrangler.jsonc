// Worker « owwomenscup-realtime » : salons temps réel (Durable Objects).
// Plan : docs/REALTIME-DO.md. Déployé par .github/workflows/realtime.yml.
// Les chemins sont relatifs à ce fichier.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "owwomenscup-realtime",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  // Étape 1 (aucun écran branché) : adresse technique pour les contrôles.
  // realtime.owwomenscup.fr viendra avec l'étape 2.
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
